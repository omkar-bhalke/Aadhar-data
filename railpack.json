{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        { "src": "requirements.txt", "dest": "requirements.txt" },
        "pip install -r requirements.txt --break-system-packages"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["...", "tesseract-ocr"]
  }
}
